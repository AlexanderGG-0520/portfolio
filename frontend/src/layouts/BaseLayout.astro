---
import '../styles/global.css';
import '../styles/readability.css';
import '../styles/locale.css';
import '../styles/background-stability.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  design?: 'a' | 'b' | 'c' | 'index';
  robots?: 'index,follow' | 'noindex,nofollow';
}

const {
  title,
  description = 'Alec — Backend, Infrastructure and Systems Engineering portfolio.',
  lang = 'en',
  design = 'index',
  robots = 'index,follow',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11111b" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{title}</title>
  </head>
  <body data-design={design}>
    <div class="viewport-background" aria-hidden="true">
      <canvas id="gpu-background" class="gpu-background"></canvas>
      <div class="pointer-glow"></div>
    </div>
    <div class="site-surface">
      <slot />
    </div>
    <script>
      import '../scripts/gpu-background.ts';
      import '../scripts/runtime.ts';
    </script>
  </body>
</html>
