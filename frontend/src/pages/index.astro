---
import { defaultLocale } from '../i18n/locales';

const fallback = `/${defaultLocale}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Alec — Portfolio</title>
    <script is:inline define:vars={{ fallback }}>
      const prefersJapanese = (navigator.languages ?? [navigator.language]).some((language) =>
        language?.toLowerCase().startsWith('ja'),
      );
      window.location.replace(prefersJapanese ? '/ja/' : fallback);
    </script>
  </head>
  <body>
    <nav aria-label="Choose language">
      <a href="/en/" hreflang="en">English</a>
      <a href="/ja/" hreflang="ja">日本語</a>
    </nav>
  </body>
</html>
