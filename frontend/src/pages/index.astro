---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Alec — Design prototypes">
  <main class="chooser shell">
    <p class="prompt"><span>alec@portfolio</span>:~$ select-design</p>
    <h1>Three terminal-inspired directions.</h1>
    <p class="lede">Same design tokens and backend. Different first-impression strategy.</p>
    <div class="chooser-grid">
      <a class="chooser-card glass-panel" href="/design/a/"><b>A</b><h2>Focus Pane</h2><p>Whitespace and typography first.</p></a>
      <a class="chooser-card glass-panel" href="/design/b/"><b>B</b><h2>Tiled Systems</h2><p>Hyprland-like panes and topology first.</p></a>
      <a class="chooser-card glass-panel" href="/design/c/"><b>C</b><h2>Signal Field</h2><p>GPU atmosphere and network flow first.</p></a>
    </div>
  </main>
</BaseLayout>
