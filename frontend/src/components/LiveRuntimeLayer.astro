---
import type { Locale } from '../i18n/locales';
import { systemModel } from '../data/system-model';
import '../styles/live-runtime.css';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const ja = lang === 'ja';
const c = ja
  ? {
      title1: 'ブラウザが問い、',
      title2: 'プロセスが答える。',
      intro: 'runtime stateはclient側で作りません。Go process自身が、release identity・process lifetime・deployment contextを明示的なpublic snapshotとして返します。',
      labels: {
        service: 'service', status: 'status', environment: 'environment', orchestrator: 'orchestrator', instance: 'instance', go: 'Go runtime', release: 'release', revision: 'revision', started: 'started at', uptime: 'uptime', time: 'server time', source: 'source',
      },
      inspect: 'inspect',
      inspectDetail: 'release identity / process start / deployment boundary',
      backendLabel: 'BACKEND RESPONSIBILITY',
      backendTitle: 'runtime truthを所有する。',
      backendBody: 'process state、release metadata、virtual portfolio shellはGoから返します。browserだけでは、実際に自分を配信しているprocessの状態をauthoritativeには知れないからです。',
      publicLabel: 'PUBLIC BOUNDARY',
      publicTitle: '公開する情報は意図的に選ぶ。',
      publicBody: 'raw Kubernetes APIも、hostnameやenvironmentの自動dumpも公開しません。deployment metadataはopt-inで、長さと文字種をfilterしたものだけをpublicにします。',
      deployLabel: 'DEPLOYMENT CONTEXT',
      deployTitle: `${systemModel.platform.orchestrator}が現在のruntime。`,
      deployBody: `Productionは${systemModel.deployment.workload}として稼働しています。Pod identityは${systemModel.deployment.instanceIdentity}から注入し、release identityは${systemModel.deployment.releaseIdentity}としてimageに固定します。上のreadoutが、このrequestを実際に返しているprocessについてのauthoritativeな情報です。`,
      principle: 'frontendはシステムを表示する。backendは、実際に動いているシステムのsource of truthを持つ。',
    }
  : {
      title1: 'The browser asks.',
      title2: 'The process answers.',
      intro: 'Runtime state is not invented in the client. The Go process reports an explicitly public snapshot of itself: release identity, process lifetime and deployment context.',
      labels: {
        service: 'service', status: 'status', environment: 'environment', orchestrator: 'orchestrator', instance: 'instance', go: 'Go runtime', release: 'release', revision: 'revision', started: 'started at', uptime: 'uptime', time: 'server time', source: 'source',
      },
      inspect: 'inspect',
      inspectDetail: 'release identity / process start / deployment boundary',
      backendLabel: 'BACKEND RESPONSIBILITY',
      backendTitle: 'Own runtime truth.',
      backendBody: 'Process state, release metadata and the virtual portfolio shell come from Go because the browser cannot authoritatively know them by itself.',
      publicLabel: 'PUBLIC BOUNDARY',
      publicTitle: 'Expose only what is intentional.',
      publicBody: 'No raw Kubernetes API and no automatic hostname or environment dump. Deployment metadata is opt-in, length-limited and filtered before it becomes public.',
      deployLabel: 'DEPLOYMENT CONTEXT',
      deployTitle: `${systemModel.platform.orchestrator} is the current runtime.`,
      deployBody: `Production runs as a ${systemModel.deployment.workload}. Pod identity is injected through the ${systemModel.deployment.instanceIdentity}, while release identity stays fixed in ${systemModel.deployment.releaseIdentity}. The readout above is authoritative for the process serving this request.`,
      principle: 'The frontend presents the system. The backend is the source of truth for the system that is actually running.',
    };
---

<section id="runtime" class="live-runtime-layer shell" aria-labelledby="runtime-heading" data-live-runtime>
  <div class="live-runtime-heading">
    <div><span class="live-runtime-index">04 / LIVE RUNTIME</span><h2 id="runtime-heading">{c.title1}<br />{c.title2}</h2></div>
    <p>{c.intro}</p>
  </div>

  <div class="live-runtime-console">
    <div class="live-runtime-request" aria-live="polite"><span>GET</span><code>/api/runtime</code><i aria-hidden="true"></i><strong data-runtime-http>connecting</strong><small data-runtime-latency>-- ms</small></div>
    <dl class="live-runtime-grid">
      <div><dt>{c.labels.service}</dt><dd data-runtime-service>portfolio-backend</dd></div>
      <div><dt>{c.labels.status}</dt><dd class="runtime-state" data-runtime-status>connecting</dd></div>
      <div><dt>{c.labels.environment}</dt><dd data-runtime-environment>--</dd></div>
      <div><dt>{c.labels.orchestrator}</dt><dd data-runtime-orchestrator>--</dd></div>
      <div data-inspect-detail><dt>{c.labels.instance}</dt><dd data-runtime-instance>--</dd></div>
      <div data-inspect-detail><dt>{c.labels.go}</dt><dd data-runtime-go>--</dd></div>
      <div data-inspect-detail><dt>{c.labels.release}</dt><dd data-runtime-version>--</dd></div>
      <div data-inspect-detail><dt>{c.labels.revision}</dt><dd data-runtime-revision>--</dd></div>
      <div data-inspect-detail><dt>{c.labels.started}</dt><dd data-runtime-started>--</dd></div>
      <div><dt>{c.labels.uptime}</dt><dd data-runtime-uptime>--</dd></div>
      <div data-inspect-detail><dt>{c.labels.time}</dt><dd data-runtime-time>--</dd></div>
      <div data-inspect-detail><dt>{c.labels.source}</dt><dd>/api/runtime</dd></div>
    </dl>
  </div>

  <button class="density-expand" type="button" data-view-mode-inspect><span>{c.inspect}</span><strong>{c.inspectDetail}</strong><i aria-hidden="true">↓</i></button>

  <div class="live-runtime-boundaries" data-inspect-detail>
    <section><span>{c.backendLabel}</span><strong>{c.backendTitle}</strong><p>{c.backendBody}</p></section>
    <section><span>{c.publicLabel}</span><strong>{c.publicTitle}</strong><p>{c.publicBody}</p></section>
    <section><span>{c.deployLabel}</span><strong>{c.deployTitle}</strong><p>{c.deployBody}</p></section>
  </div>

  <div class="live-runtime-principle"><span>DESIGN PRINCIPLE</span><p>{c.principle}</p></div>
</section>

<script>
  import '../scripts/live-runtime.ts';
</script>
