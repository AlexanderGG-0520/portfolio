---
import { alternateLocale, type Locale } from '../i18n/locales';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const ja = lang === 'ja';
const otherLocale = alternateLocale(lang);
const c = ja
  ? {
      close: 'ナビゲーションを閉じる',
      navAria: 'モバイルナビゲーション',
      top: 'トップ', topDetail: 'プロフィール / 主張',
      system: 'システム', systemDetail: '責務境界',
      cases: 'Case Studies', casesDetail: '起点 / 問題 / 設計',
      evidence: '証拠', evidenceDetail: 'code / incident / operation',
      runtime: 'Live Runtime', runtimeDetail: 'Go process / release / deployment truth',
      viewDetail: '要約を先に / 詳細は必要なときに',
      terminalDetail: 'fish-inspired portfolio shell',
      githubDetail: 'repository / history',
      language: 'English', languageDetail: '英語版へ切り替える',
      backendStatus: 'Portfolio backendの状態',
    }
  : {
      close: 'Close navigation',
      navAria: 'Mobile navigation',
      top: 'top', topDetail: 'identity / thesis',
      system: 'system', systemDetail: 'responsibility boundaries',
      cases: 'case studies', casesDetail: 'origin / problem / design',
      evidence: 'evidence', evidenceDetail: 'code / incidents / operation',
      runtime: 'live runtime', runtimeDetail: 'Go process / release / deployment truth',
      viewDetail: 'summary first / details on demand',
      terminalDetail: 'fish-inspired portfolio shell',
      githubDetail: 'repositories / history',
      language: '日本語', languageDetail: 'switch to Japanese',
      backendStatus: 'Portfolio backend status',
    };
---

<button class="mobile-nav-trigger" type="button" aria-controls="mobile-navigation" aria-expanded="false" data-mobile-nav-open>
  <span>nav</span><b aria-hidden="true">/</b>
</button>

<div class="mobile-nav-layer" data-mobile-nav aria-hidden="true" inert>
  <button class="mobile-nav-backdrop" type="button" aria-label={c.close} tabindex="-1" data-mobile-nav-close></button>
  <nav id="mobile-navigation" class="mobile-nav-panel" aria-label={c.navAria}>
    <div class="mobile-nav-bar"><span>~/portfolio / nav</span><button type="button" data-mobile-nav-close>esc</button></div>
    <div class="mobile-nav-links">
      <a href="#top" data-mobile-nav-link><span>00</span><strong>{c.top}</strong><small>{c.topDetail}</small><i aria-hidden="true">↑</i></a>
      <a href="#architecture" data-mobile-nav-link><span>01</span><strong>{c.system}</strong><small>{c.systemDetail}</small><i aria-hidden="true">↓</i></a>
      <a href="#case-studies" data-mobile-nav-link><span>02</span><strong>{c.cases}</strong><small>{c.casesDetail}</small><i aria-hidden="true">↓</i></a>
      <a href="#evidence" data-mobile-nav-link><span>03</span><strong>{c.evidence}</strong><small>{c.evidenceDetail}</small><i aria-hidden="true">↓</i></a>
      <a href="#runtime" data-mobile-nav-link><span>04</span><strong>{c.runtime}</strong><small>{c.runtimeDetail}</small><i aria-hidden="true">↓</i></a>
      <button type="button" data-view-mode-toggle aria-pressed="false" aria-label={ja ? '詳細表示に切り替える' : 'Switch to inspect view'} data-view-mode-skim-aria={ja ? '要約表示に切り替える' : 'Switch to skim view'} data-view-mode-inspect-aria={ja ? '詳細表示に切り替える' : 'Switch to inspect view'}>
        <span>view</span><strong data-view-mode-label>skim</strong><small>{c.viewDetail}</small><i aria-hidden="true">⇄</i>
      </button>
      <button type="button" data-terminal-open data-mobile-nav-terminal><span>tty</span><strong>terminal ~</strong><small>{c.terminalDetail}</small><i aria-hidden="true">❯</i></button>
      <a href={`/${otherLocale}/`} hreflang={otherLocale} data-mobile-nav-link><span>lang</span><strong>{c.language}</strong><small>{c.languageDetail}</small><i aria-hidden="true">↔</i></a>
      <a href="https://github.com/AlexanderGG-0520" rel="me" data-mobile-nav-link><span>git</span><strong>github</strong><small>{c.githubDetail}</small><i aria-hidden="true">↗</i></a>
    </div>
    <div class="mobile-nav-runtime" aria-label={c.backendStatus}><span class="status-dot"></span><span>backend:</span><strong data-api-status>connecting</strong></div>
  </nav>
</div>

<script>
  import '../scripts/mobile-navigation.ts';
</script>
