---
import type { Locale } from '../i18n/locales';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const ariaLabel = lang === 'ja' ? '詳細表示に切り替える' : 'Switch to inspect view';
---

<button
  class="view-mode-control"
  type="button"
  data-view-mode-toggle
  aria-pressed="false"
  aria-label={ariaLabel}
>
  <span>view</span>
  <i aria-hidden="true">/</i>
  <strong data-view-mode-label>skim</strong>
</button>

<script>
  import '../scripts/view-mode.ts';
</script>
