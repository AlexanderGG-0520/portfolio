---
import type { Locale } from '../i18n/locales';
import '../styles/architecture.css';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const c = lang === 'ja'
  ? {
      index: '01 / architecture',
      title1: '一つのシステム。',
      title2: '複数の責務境界。',
      intro: '重要なのは技術の数ではありません。public trafficから永続state、その下の物理マシンまで、各layerがシステムのどの責務を持つかを分けています。',
      publicDetail: '2つのtraffic path / 1つの運用platform',
      portfolioDetail: 'Astro frontend ↔ Go API',
      webDetail: 'HTTP(S) / application surface',
      routerDetail: 'protocol-aware routing',
      routerTransport: 'Java handshake / TCP :25565',
      workloadDetail: 'container lifecycle / 永続world state',
      platformDetail: 'desired → ready',
      network: 'network',
      storage: 'storage',
      delivery: 'delivery',
      runtime: 'runtime',
      cpDetail: 'cluster control / etcd',
      workerDetail: 'application workloads',
      proxmoxDetail: 'VM lifecycleとKubernetes workload lifecycleを分離',
      hardware: 'Control PlaneとWorkerは現在も論理的には分離していますが、同じ1台の物理サーバー上で動いています。現在をHAだと見せかけず、この設計のまま将来の物理node追加へ拡張できます。',
      principle: 'ソフトウェアはprocess boundaryで完成ではありません。routing、runtime lifecycle、永続state、orchestration、そしてその下のinfrastructureまで、設計・実装・運用するシステムの一部です。',
      next: '02 / case studies',
      descend: 'さらに具体化する ↓',
      nextAria: 'Case Studiesへ進む',
      platformAria: 'Kubernetes platformの責務',
    }
  : {
      index: '01 / architecture',
      title1: 'One system.',
      title2: 'Several responsibility boundaries.',
      intro: 'The point is not the number of technologies. It is how each layer owns a different part of the system, from public traffic to persistent state and the physical machine underneath it.',
      publicDetail: 'two traffic paths / one operating platform',
      portfolioDetail: 'Astro frontend ↔ Go API',
      webDetail: 'HTTP(S) / application surface',
      routerDetail: 'protocol-aware routing',
      routerTransport: 'Java handshake / TCP :25565',
      workloadDetail: 'container lifecycle / persistent world state',
      platformDetail: 'desired → ready',
      network: 'network',
      storage: 'storage',
      delivery: 'delivery',
      runtime: 'runtime',
      cpDetail: 'cluster control / etcd',
      workerDetail: 'application workloads',
      proxmoxDetail: 'separates VM lifecycle from Kubernetes workload lifecycle',
      hardware: 'Control Plane and Worker are logically separated today, but they still share one physical server. The design can grow into additional physical nodes without pretending the current setup is HA.',
      principle: 'Software is not finished at the process boundary. Routing, runtime lifecycle, persistent state, orchestration and the infrastructure below it are part of the system I design and operate.',
      next: '02 / case studies',
      descend: 'descend further ↓',
      nextAria: 'Continue to case studies',
      platformAria: 'Kubernetes platform responsibilities',
    };
---

<section id="architecture" class="architecture-layer shell" data-architecture-layer aria-labelledby="architecture-title">
  <header class="architecture-heading">
    <div>
      <span class="architecture-index">{c.index}</span>
      <h2 id="architecture-title">{c.title1}<br />{c.title2}</h2>
    </div>

    <p>{c.intro}</p>
  </header>

  <div class="architecture-map" data-architecture-map>
    <div class="architecture-spine" aria-hidden="true"></div>

    <div class="architecture-origin architecture-reveal" style="--step: 0">
      <span class="architecture-label">PUBLIC</span>
      <strong>Internet</strong>
      <small>{c.publicDetail}</small>
    </div>

    <div class="architecture-lanes architecture-reveal" style="--step: 1">
      <article class="architecture-lane architecture-lane-web">
        <span class="architecture-label">WEB</span>
        <div class="lane-flow" aria-hidden="true"><i></i></div>
        <strong>Portfolio</strong>
        <p>{c.portfolioDetail}</p>
        <small>{c.webDetail}</small>
      </article>

      <article class="architecture-lane architecture-lane-game">
        <span class="architecture-label">MINECRAFT EDGE</span>
        <div class="lane-flow" aria-hidden="true"><i></i></div>
        <strong>mc-router</strong>
        <p>{c.routerDetail}</p>
        <small>{c.routerTransport}</small>
      </article>
    </div>

    <div class="architecture-workloads architecture-reveal" style="--step: 2">
      <div class="workload-note">
        <span class="architecture-label">STATEFUL RUNTIME</span>
        <strong>Minecartainer</strong>
        <small>{c.workloadDetail}</small>
      </div>
      <span class="workload-join" aria-hidden="true">↘</span>
    </div>

    <div class="architecture-platform architecture-reveal" style="--step: 3">
      <div class="platform-title">
        <span class="architecture-label">PLATFORM</span>
        <strong>Kubernetes</strong>
        <small>{c.platformDetail}</small>
      </div>

      <div class="platform-services" aria-label={c.platformAria}>
        <span>Cilium <small>{c.network}</small></span>
        <span>Longhorn <small>{c.storage}</small></span>
        <span>Argo CD <small>{c.delivery}</small></span>
        <span>CRI-O <small>{c.runtime}</small></span>
      </div>
    </div>

    <div class="architecture-nodes architecture-reveal" style="--step: 4">
      <div>
        <span class="architecture-label">CONTROL PLANE VM</span>
        <strong>cp-01</strong>
        <small>{c.cpDetail}</small>
      </div>
      <div>
        <span class="architecture-label">WORKER VM</span>
        <strong>worker-01</strong>
        <small>{c.workerDetail}</small>
      </div>
    </div>

    <div class="architecture-proxmox architecture-reveal" style="--step: 5">
      <span class="architecture-label">VIRTUALIZATION</span>
      <strong>Proxmox VE</strong>
      <small>{c.proxmoxDetail}</small>
    </div>

    <div class="architecture-hardware architecture-reveal" style="--step: 6">
      <div>
        <span class="architecture-label">PHYSICAL FAILURE DOMAIN</span>
        <strong>1 host</strong>
      </div>
      <p>{c.hardware}</p>
    </div>
  </div>

  <div class="architecture-principle architecture-reveal" style="--step: 7">
    <span class="architecture-label">DESIGN PRINCIPLE</span>
    <p>{c.principle}</p>
  </div>

  <a class="architecture-next" href="#case-studies" aria-label={c.nextAria}>
    <span>{c.next}</span>
    <i></i>
    <span>{c.descend}</span>
  </a>
</section>

<script>
  import '../scripts/architecture.ts';
</script>
